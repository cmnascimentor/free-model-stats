# Provider credentials
NIM_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter quota / client behavior
OPENROUTER_STATS_DELAY=3.5
OPENROUTER_APP_TITLE=free-model-stats
# OPENROUTER_SITE_URL=https://your-dashboard.example
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_RETRY_BASE_DELAY=5

# NVIDIA NIM benchmark controls
# NIM_MODEL_LIMIT=0
# REQUEST_TIMEOUT_SECONDS=300
# DISCOVERY_TIMEOUT_SECONDS=30

# Optional local live runner. Keep loopback unless you deliberately expose it.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8420
# Set a strong random value when binding beyond loopback. When the dashboard is
# served by runner_server.py, authenticated browser calls are wired automatically.
# RUNNER_TOKEN=replace-with-a-long-random-secret
